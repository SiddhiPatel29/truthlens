# VeraMedia AI Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production credentials to source control.

# Application Environment (development, testing, production)
FLASK_ENV=development

# Enable Flask interactive debugging (1 for enabled, 0 for disabled)
FLASK_DEBUG=1

# Server Port
PORT=5000

# Secret Key for session signing and cryptographic helpers
# In production, replace with a strong random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=dev_insecure_secret_key_change_in_production

# Frontend Origin for CORS (e.g. http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000

# Maximum Allowed Request Payload Size in Megabytes (Flask MAX_CONTENT_LENGTH)
MAX_CONTENT_LENGTH_MB=50

# Database Connection URI (defaults to SQLite in development)
# For production PostgreSQL: postgresql://user:password@localhost:5432/truthlens_db
DATABASE_URL=sqlite:///truthlens.db

# JWT Configuration
# In production, set a cryptographically secure random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production
JWT_EXPIRATION_HOURS=24

# Rate Limiting & DoS Protection (SEC-08)
# Enable or disable rate limiting globally (1/true to enable, 0/false to disable)
RATELIMIT_ENABLED=true
# Rate limit storage URI. Default is in-process memory ('memory://').
# NOTE: In-process memory storage is process-local and is not globally synchronized
# across multiple Gunicorn worker processes. For multi-worker production deployments,
# set RATELIMIT_STORAGE_URI to a shared backend such as redis://localhost:6379/0.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_STRATEGY=fixed-window
